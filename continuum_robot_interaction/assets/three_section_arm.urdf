<?xml version="1.0"?>
<!-- SI units. Elastomer density 1100 kg/m^3; solid box inertias at each COM. -->
<!-- Revolute joints discretize bending; compliant Newton drives are configured at runtime. -->
<robot name="three_section_continuum_arm">
  <material name="base"><color rgba="0.22 0.25 0.29 1"/></material>
  <material name="section1"><color rgba="0.18 0.42 0.57 1"/></material>
  <material name="section2"><color rgba="0.10 0.66 0.70 1"/></material>
  <material name="section3"><color rgba="0.95 0.57 0.20 1"/></material>
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.02"/>
      <mass value="2.1168"/>
      <inertia ixx="0.00373968" ixy="0" ixz="0" iyy="0.00373968" iyz="0" izz="0.00691488"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.14 0.14 0.04"/></geometry>
      <material name="base"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.14 0.14 0.04"/></geometry>
    </collision>
  </link>
  <!-- Aluminum yaw bearing recessed into the pedestal; its top is the arm pivot. -->
  <link name="yaw_link">
    <inertial>
      <origin xyz="0 0 -0.004"/>
      <mass value="0.0831265416140"/>
      <inertia ixx="0.0000259008449246" ixy="0" ixz="0" iyy="0.0000259008449246" iyz="0" izz="0.0000509150067386"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.004"/>
      <geometry><cylinder radius="0.035" length="0.008"/></geometry>
      <material name="base"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.004"/>
      <geometry><cylinder radius="0.035" length="0.008"/></geometry>
    </collision>
  </link>
  <joint name="base_yaw_joint" type="continuous">
    <parent link="base_link"/>
    <child link="yaw_link"/>
    <origin xyz="0 0 0.04"/>
    <axis xyz="0 0 1"/>
    <limit effort="12" velocity="1.5"/>
    <dynamics damping="0.2" friction="0.001"/>
  </joint>
